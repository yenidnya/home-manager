{
    "$schema": "https://opencode.ai/config.json",
    "share": "disabled",
    "default_agent": "build",
    "permission": {
        "bash": {
            "git *": "ask",
            "git branch": "allow",
            "git -C * branch": "allow",
            "git blame*": "allow",
            "git -C * blame*": "allow",
            "git diff*": "allow",
            "git -C * diff*": "allow",
            "git grep*": "allow",
            "git -C * grep*": "allow",
            "git log*": "allow",
            "git -C * log*": "allow",
            "git ls-files*": "allow",
            "git -C * ls-files*": "allow",
            "git rev-parse*": "allow",
            "git -C * rev-parse*": "allow",
            "git show*": "allow",
            "git -C * show*": "allow",
            "git status*": "allow",
            "git -C * status*": "allow"
        },
        "external_directory": "allow",
        "doom_loop": "allow",
        "skill": "allow"
    },
    "mcp": {
        "codebase-memory-mcp": {
            "command": [
                "codebase-memory-mcp"
            ],
            "type": "local"
        },
        "figma": {
            "type": "remote",
            "url": "http://127.0.0.1:3845/mcp",
            "enabled": true
        }
    },
    "instructions": [
        "~/.config/steering/*.md"
    ]
}
