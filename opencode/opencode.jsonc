{
    "$schema": "https://opencode.ai/config.json",
    "share": "disabled",
    "default_agent": "build",
    "permissions": [
        {
            "action": "shell",
            "resource": "git *",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "git branch",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git -C * branch",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git blame*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git -C * blame*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git diff*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git -C * diff*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git grep*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git -C * grep*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git log*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git -C * log*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git ls-files*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git -C * ls-files*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git rev-parse*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git -C * rev-parse*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git show*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git -C * show*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git status*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git -C * status*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "allow"
        }
    ],
    "mcp": {
        "servers": {
            "codebase-memory-mcp": {
                "type": "local",
                "command": [
                    "codebase-memory-mcp"
                ]
            },
            "figma": {
                "type": "remote",
                "url": "http://127.0.0.1:3845/mcp"
            },
        }
    },
    "experimental": {
        "todo": true
    },
    "skills": [
        "~/.claude/skills"
    ],
    "instructions": [
        "~/.config/steering/*.md"
    ]
}
